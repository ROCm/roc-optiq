#pragma once

#define ROCPROFVIS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ROCPROFVIS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ROCPROFVIS_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ROCPROFVIS_VERSION_BUILD @PROJECT_VERSION_BUILD@

// Full git commit of an official build, or "unknown" for any other build.
